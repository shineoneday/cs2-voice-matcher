/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/Dockerfile
!/docker-compose.yml
!/cs2-voice-matcher.csproj
!/Program.cs
!/wwwroot/

!/Core/
/Core/*
!/Core/Models.cs
!/Core/DatabaseSchema.cs
